NODE_ENV=test
PORT=4000

# Jest's integration tests must never point at the same database as `npm run dev`
# (they create/tear down real rows). Use a separate database name here.
DATABASE_URL="postgresql://oism:oism_password@localhost:5432/oism_test?schema=public"

JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars_______
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars______
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
RESERVATION_EXPIRY_MINUTES=30
