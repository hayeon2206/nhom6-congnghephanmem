PORT=4000
NODE_ENV=development

# PostgreSQL connection used by Prisma.
# connection_limit/pool_timeout are raised above Prisma's defaults (num_cpus*2+1 / 10s):
# under a heavy burst (100+ truly concurrent requests, e.g. the webhook anti-oversell
# load test) the default pool can queue requests past the default 10s timeout and
# surface spurious "timed out fetching a connection" errors that have nothing to do
# with the anti-oversell logic itself. Raise connection_limit further if Postgres'
# own max_connections has headroom for it.
DATABASE_URL="postgresql://oism:oism_password@localhost:5432/oism?schema=public&connection_limit=30&pool_timeout=30"

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars_______
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars______
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - frontend origin
CORS_ORIGIN=http://localhost:5173

# Reserved orders older than this (minutes) are auto-cancelled by the background job
RESERVATION_EXPIRY_MINUTES=30
